{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "ES2024.Promise", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "deploy/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
}
